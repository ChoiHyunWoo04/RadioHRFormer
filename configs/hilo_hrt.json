{
  "seed": 42,

  "data": {
    "root_dir": "/home/ailab/Desktop/data/radiomapseer/",
    "image_size": 256,
    "num_tx": 80,

    "cars_input": false,
    "target_type": "DPM",

    "thresh": 0.0,
    "batch_size": 32,
    "num_workers": 4,
    "pin_memory": true,
    "persistent_workers": true,
    "return_name": false,

    "use_tx_gaussian_map": false,
    "tx_gaussian_sigma": 6.0,

    "augment": false,
    "crop_scale": [0.8, 1.0],
    "hflip_prob": 0.5,
    "vflip_prob": 0.5
  },

  "model": {
    "name": "HRFormerRadioMapRegressor",
    "in_channels": 3,
    "out_channels": 1,
    "branch_index": 0,
    "use_stem_skip": true,

    "norm_cfg": {
      "type": "BN",
      "requires_grad": true
    },

    "backbone": {
        "type": "HiLoHRT",
        "variant": "hilo_hrt_small",
        "pretrained": null,
        "extra": {
            "drop_path_rate": 0.25,

            "branch_strides": [1, 8],

            "stage1": {
            "num_modules": 1,
            "num_branches": 1,
            "block": "BOTTLENECK",
            "num_blocks": [2],
            "num_channels": [64],
            "num_heads": [2],
            "num_mlp_ratios": [4]
            },

            "stage2": {
            "num_modules": 1,
            "num_branches": 2,
            "block": "TRANSFORMER_BLOCK",
            "num_blocks": [2, 2],
            "num_channels": [32, 128],
            "num_heads": [1, 8],
            "num_mlp_ratios": [4, 4],
            "num_window_sizes": [8, 8]
            },

            "stage3": {
            "num_modules": 4,
            "num_branches": 2,
            "block": "TRANSFORMER_BLOCK",
            "num_blocks": [2, 2],
            "num_channels": [32, 128],
            "num_heads": [1, 8],
            "num_mlp_ratios": [4, 4],
            "num_window_sizes": [8, 8]
            },

            "stage4": {
            "num_modules": 2,
            "num_branches": 2,
            "block": "TRANSFORMER_BLOCK",
            "num_blocks": [2, 2],
            "num_channels": [32, 128],
            "num_heads": [1, 8],
            "num_mlp_ratios": [4, 4],
            "num_window_sizes": [8, 8],
            "multiscale_output": false
            }
        }
    },

    "decoder": {
      "type": "HRFormerSkipDecoder",
      "in_channels": 32,
      "stem2_channels": 64,
      "stem1_channels": 64,
      "hidden_channels": 64,
      "out_channels": 1
    }
  },

  "pretrain": {
    "epochs": 100,
    "lr": 0.0001,
    "weight_decay": 0.0001,
    "warmup_epochs": 5,
    "min_lr": 0.000001
  },

  "physics": {
    "targets": ["grad", "lap", "k2", "kneg"],
    "field_mode": "normalized_power",
    "gaussian_sigma": 2.0,
    "kneg_percentile": 5.0,
    "building_channel": 0,
    "tx_channel": -1,
    "building_threshold": 0.5
  },

  "train": {
    "epochs": 100,
    "lr": 0.0001,
    "weight_decay": 0.0001,
    "warmup_epochs": 5,
    "min_lr": 0.000001,
    "loss": "joint"
  }
}