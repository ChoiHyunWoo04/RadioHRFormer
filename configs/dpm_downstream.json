{
  "seed": 42,
  "runtime": {"gpus": [0], "amp": true},
  "data": {
    "root_dir": "./data/radiomapseer/",
    "num_tx": 80,
    "target_type": "DPM",
    "thresh": 0.0,
    "batch_size": 32,
    "num_workers": 4,
    "pin_memory": true,
    "persistent_workers": true,
    "return_name": false
  },
  "model": {
    "in_channels": 3,
    "branch_index": 0,
    "use_stem_skip": true,
    "norm_cfg": {
      "type": "BN",
      "requires_grad": true
    },
    "backbone": {
      "type": "HRT",
      "extra": {
        "drop_path_rate": 0.35,

        "stage1": {
          "num_modules": 1,
          "num_branches": 1,
          "block": "BOTTLENECK",
          "num_blocks": [2],
          "num_channels": [64]
        },

        "stage2": {
          "num_modules": 1,
          "num_branches": 2,
          "block": "TRANSFORMER_BLOCK",
          "num_blocks": [2, 2],
          "num_channels": [48, 64],
          "num_heads": [1, 2],
          "num_mlp_ratios": [4, 4],
          "num_window_sizes": [8, 8]
        },

        "stage3": {
          "num_modules": 4,
          "num_branches": 3,
          "block": "TRANSFORMER_BLOCK",
          "num_blocks": [2, 2, 2],
          "num_channels": [48, 64, 128],
          "num_heads": [1, 2, 4],
          "num_mlp_ratios": [4, 4, 4],
          "num_window_sizes": [8, 8, 8]
        },

        "stage4": {
          "num_modules": 4,
          "num_branches": 4,
          "block": "TRANSFORMER_BLOCK",
          "num_blocks": [2, 2, 2, 2],
          "num_channels": [48, 64, 128, 256],
          "num_heads": [1, 2, 4, 8],
          "num_mlp_ratios": [4, 4, 4, 4],
          "num_window_sizes": [8, 8, 8, 8],
          "multiscale_output": false
        }
      }
    },

    "decoder": {
      "type": "HRFormerSkipDecoder",
      "in_channels": 48,
      "stem2_channels": 64,
      "stem1_channels": 64,
      "hidden_channels": 64,
      "out_channels": 1
    }
  },
  "train": {
    "epochs": 100,
    "lr": 0.0005,
    "weight_decay": 0.0001,
    "warmup_epochs": 5,
    "min_lr": 1e-06,
    "loss": "joint"
  }
}
